model Client {
     id           Int                 @id @default(autoincrement())
     phone        String
     userId       String              @unique @db.Uuid
     name         String
     user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
     subscription ClientSubscription?
     likedPosts   PostLike[]
     reviews      PostReview[]
}

model Subscription {
     id                  Int                  @id @default(autoincrement())
     name                String               @unique
     price               Int
     currency            String @default("USD")
     duration            Int @default(0)
     durationUnit        String @default("month")
     benefits            String[] @default([])
     isActive            Boolean              @default(true)
     description         String
     iremboProductCode     String?
     clientSubscriptions ClientSubscription[]
     transactions        Transaction[]
}

model ClientSubscription {
     id             Int           @id @default(autoincrement())
     createdAt      DateTime @default(now())
     updatedAt      DateTime @updatedAt
     expiryAt       DateTime?
     clientId       Int           @unique
     subscriptionId Int
     client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
     subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
     transactions   Transaction[]
}

enum ETransactionProvider {
     MANUAL
     IREMBO_PAY
}

enum ETransactionStatus {
     NONE
     PENDING
     PAID
     PARTIALLY_PAID
     FAILED
     EXPIRED
     CANCELLED
}

model Transaction {
     id                   Int                @id @default(autoincrement())
     price                Int
     quantity             Int
     amount               Int
     proof                String             @default("")
     createdAt            DateTime       @default(now())
     updatedAt            DateTime      @updatedAt
     status               String
     verificationCode     Int @default(0)
     clientSubscriptionId Int
     payNumber            String
     transactionMethod    String

     // for irembo internal transaction id
     invoiceNumber         String? @unique
     paymentMethod         String?
     provider            ETransactionProvider @default(MANUAL)
     transactionStatus     ETransactionStatus @default(NONE)

     // The plan this payment is for. ClientSubscription.subscriptionId is only switched to it
     // once the payment is confirmed (a client can be on plan A while paying for plan B).
     subscriptionId        Int?
     subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

     // Concurrency guard: holds clientSubscriptionId while this transaction is the client's open
     // (PENDING) IremboPay payment, NULL otherwise. The unique index makes it impossible for a
     // client to hold two open invoices at once, even under concurrent requests.
     pendingKey            Int? @unique

     clientSubscription   ClientSubscription @relation(fields: [clientSubscriptionId], references: [id], onDelete: Cascade)
}


