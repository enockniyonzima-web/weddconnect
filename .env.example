# Copy to .env and fill in the values. Never commit real values.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (S3) — server only
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_S3_REGION=""
NEXT_PUBLIC_AWS_S3_REGION=""

# App URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
SERVER_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_SERVER_API_URL="http://localhost:3000/api"

# IremboPay
IPAY_SECRET_KEY=""
IPAY_ENVIRONMENT="sandbox"
IPAY_PAYMENT_ACCOUNT_IDENTIFIER=""
NEXT_PUBLIC_IPAY_PUBLIC_KEY=""
NEXT_PUBLIC_IPAY_ENVIRONMENT="sandbox"
NEXT_PUBLIC_IPAY_WIDGET_SRC=""

# Optional: set to "true" to run the bundle analyzer on build
ANALYZE="false"
